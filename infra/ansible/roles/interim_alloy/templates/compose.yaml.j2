# Managed by Ansible (role interim_alloy).
name: malgary-alloy
services:
  alloy:
    image: grafana/alloy:v1.11.0
    restart: unless-stopped
    command: ["run", "/etc/alloy/config.alloy", "--storage.path=/var/lib/alloy"]
    volumes:
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - {{ grafana_api_key_file }}:/run/secrets/grafana-api-key:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks: [coolify, gateway]
    mem_limit: {{ interim_mem.alloy }}m
    memswap_limit: {{ interim_mem.alloy }}m
    labels:
      com.malgary.managed: "true"
      com.malgary.component: "alloy"
networks:
  coolify: {name: "{{ coolify_network }}", external: true}
  gateway: {name: "{{ interim_gw_network }}", external: true}
