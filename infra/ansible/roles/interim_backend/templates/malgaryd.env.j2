# Managed by Ansible (role interim_backend). Interim host settings (feature 002, data-model.md).
MALGARY_LISTEN=0.0.0.0:18090
MALGARY_METRICS_LISTEN=0.0.0.0:9100
MALGARY_DATABASE_URL=postgres://malgary_app:{{ app_pw | urlencode }}@{{ interim_pg_container }}:5432/malgary?sslmode=disable
MALGARY_MIGRATE_DATABASE_URL=postgres://malgary_owner:{{ owner_pw | urlencode }}@{{ interim_pg_container }}:5432/malgary?sslmode=disable
MALGARY_ZITADEL_ISSUER=https://id.{{ dns_zone }}
MALGARY_ZITADEL_KEY_REF=secret://zitadel-machine-key.json
MALGARY_ZITADEL_GOOGLE_IDP_ID={{ interim_google_idp_id | default('') }}
MALGARY_API_AUDIENCE={{ interim_api_audience | default("") }}
MALGARY_OWNER_EMAIL={{ interim_owner_email }}
MALGARY_BASE_DOMAIN={{ dns_zone }}
MALGARY_SECRET_DIR={{ interim_secrets }}
MALGARY_SPEC_DIR={{ interim_root }}/specs
MALGARY_CELL_INVENTORY={{ interim_root }}/cells/*.yaml
MALGARY_NETBIRD_VERSION={{ interim_netbird_version }}
MALGARY_INVITE_DELIVERY=link

MALGARY_DEPLOYER=compose
MALGARY_STACK_DIR={{ interim_root }}/stacks
MALGARY_TRAEFIK_NETWORK={{ coolify_network }}
MALGARY_TRAEFIK_ENTRYPOINT={{ coolify_entrypoint }}
MALGARY_TRAEFIK_CERTRESOLVER={{ coolify_certresolver }}
MALGARY_STACK_DB_HOST={{ interim_pg_container }}
MALGARY_GW_NETWORK={{ interim_gw_network }}
MALGARY_HOST_PUBLIC_IP={{ interim_host_ip }}
MALGARY_OPERATOR_ALLOWLIST={{ interim_operator_allowlist | join(',') }}
MALGARY_PROVISIONER_PASSWORD_REF=secret://provisioner-password
MALGARY_GUARD_IMAGE=malgary/gw-guard:local
MALGARY_PROBE_IMAGE=malgary/isolation-probe:local

MALGARY_INTERIM=true
MALGARY_INTERIM_MAX_USERS={{ interim_max_users }}
MALGARY_INTERIM_UNTIL={{ interim_until }}
MALGARY_INTERIM_TEST_TENANTS={{ interim_test_tenants }}
MALGARY_INTERIM_TEST_DOMAINS={{ interim_test_domains }}
MALGARY_INTERIM_EGRESS_NOTE={{ interim_egress_note }}
MALGARY_MEMORY_BUDGET_MB={{ interim_memory_budget_mb }}
