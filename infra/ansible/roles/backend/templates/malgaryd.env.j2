MALGARY_LISTEN=127.0.0.1:{{ backend_port }}
MALGARY_METRICS_LISTEN=127.0.0.1:{{ backend_metrics_port }}
MALGARY_DATABASE_URL=postgres://malgary_app:{{ secrets.postgres.malgary_app }}@127.0.0.1:5432/malgary?sslmode=disable
MALGARY_MIGRATE_DATABASE_URL=postgres://malgary_owner:{{ secrets.postgres.malgary_owner }}@127.0.0.1:5432/malgary?sslmode=disable
MALGARY_ZITADEL_ISSUER=https://id.{{ dns_zone }}
MALGARY_ZITADEL_KEY_REF=secret://zitadel-machine-key.json
MALGARY_BASE_DOMAIN={{ dns_zone }}
MALGARY_SECRET_DIR=/etc/malgary/secrets
MALGARY_API_AUDIENCE={{ secrets.zitadel.api_project_id | default('') }}
MALGARY_CELL_INVENTORY=/etc/malgary/cells/*.yaml
MALGARY_SPEC_DIR=/opt/malgary/specs
MALGARY_SPACES_ENDPOINT=ams3.digitaloceanspaces.com
MALGARY_ARTIFACTS_BUCKET=malgary-{{ malgary_cell }}-artifacts
MALGARY_NETBIRD_VERSION=0.82.0
